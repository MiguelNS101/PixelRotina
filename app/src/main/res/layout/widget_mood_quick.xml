<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:clipToOutline="true"
    tools:targetApi="s">

    <ImageView
        android:id="@+id/widget_bg_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/img_pixel_hero_night" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_widget_scrim"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_accent_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_theme_rim" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_widget_frame"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/widget_compact_padding_h"
        android:paddingTop="@dimen/widget_compact_padding_v"
        android:paddingEnd="@dimen/widget_compact_padding_h"
        android:paddingBottom="@dimen/widget_compact_padding_v">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_mood_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#FF000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="1"
                android:text="HUMOR AGORA (1–5)"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/widget_mood_avg_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_badge"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="DIÁRIO"
                android:textColor="#FFF9E2AF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/widget_mood_reset_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_widget_badge"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="↩"
                android:textColor="#FFF38BA8"
                android:textSize="9sp"
                android:textStyle="bold"
                android:typeface="monospace"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 5 Pixel Art Rating Tiles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="5dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_btn_level_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_tile"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/widget_icon_level_1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/notif_cd_level_1"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/widget_label_level_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="1"
                    android:textColor="#FFF38BA8"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_btn_level_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_tile"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/widget_icon_level_2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/notif_cd_level_2"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/widget_label_level_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="2"
                    android:textColor="#FFFAB387"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_btn_level_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_tile"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/widget_icon_level_3"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/notif_cd_level_3"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/widget_label_level_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="3"
                    android:textColor="#FF74C7EC"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_btn_level_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_tile"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/widget_icon_level_4"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/notif_cd_level_4"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/widget_label_level_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="4"
                    android:textColor="#FFCBA6F7"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_btn_level_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_tile"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/widget_icon_level_5"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/notif_cd_level_5"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/widget_label_level_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="5"
                    android:textColor="#FFA6E3A1"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:typeface="monospace" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
