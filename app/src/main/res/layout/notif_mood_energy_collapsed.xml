<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="#FF11111B">

    <!-- Full-bleed pixel art scene backdrop -->
    <ImageView
        android:id="@+id/notif_bg_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/img_pixel_hero_night" />

    <!-- Scrim for legibility -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_notif_scrim_collapsed"
        android:contentDescription="@null" />

    <!-- Dynamic theme pixel accent strip -->
    <ImageView
        android:id="@+id/notif_accent_bar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:background="#FFCBA6F7"
        android:contentDescription="@null" />

    <!-- Retro 8-bit border frame -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_notif_pixel_frame"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/notif_sprite_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/notif_cd_activity_sprite"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#FF000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/notif_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFDDE2F5"
                android:textSize="11sp"
                android:typeface="monospace" />
        </LinearLayout>

        <TextView
            android:id="@+id/notif_step_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_notif_pixel_badge"
            android:paddingStart="7dp"
            android:paddingTop="4dp"
            android:paddingEnd="7dp"
            android:paddingBottom="4dp"
            android:textColor="#FFCBA6F7"
            android:textSize="10sp"
            android:textStyle="bold"
            android:typeface="monospace" />
    </LinearLayout>
</FrameLayout>
