<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_container"
    android:clipToOutline="true"
    tools:targetApi="s">

    <ImageView
        android:id="@+id/widget_bg_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/img_pixel_hero_banner" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_widget_scrim"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_accent_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_theme_rim" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_widget_frame"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/widget_content_padding">

        <!-- Top row: Streak flame + days pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_streak_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/widget_cd_streak"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/widget_streak_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_widget_badge"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:text="0d"
                android:textColor="#FFFAB387"
                android:textSize="9sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_percent_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_badge"
                android:paddingStart="5dp"
                android:paddingTop="2dp"
                android:paddingEnd="5dp"
                android:paddingBottom="2dp"
                android:text="0%"
                android:textColor="#FFA6E3A1"
                android:textSize="9sp"
                android:textStyle="bold"
                android:typeface="monospace" />
        </LinearLayout>

        <!-- Center Medal -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_medal_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="@string/widget_cd_medal"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/widget_medal_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:shadowColor="#FF000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="META 50%"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/widget_tasks_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="0/0 rotinas"
            android:textColor="#FFDDE2F5"
            android:textSize="9sp"
            android:typeface="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Pixel progress bar -->
        <ImageView
            android:id="@+id/widget_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:contentDescription="@string/widget_cd_progress"
            android:scaleType="fitXY" />

        <TextView
            android:id="@+id/widget_mood_pill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Toque p/ abrir"
            android:textColor="#FFF9E2AF"
            android:textSize="8sp"
            android:textStyle="bold"
            android:typeface="monospace" />
    </LinearLayout>
</FrameLayout>
